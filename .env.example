# Runtime (inlined into the JS bundle; never put secrets here)
EXPO_PUBLIC_MOCK_LATENCY_MS=450
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
# Public share links; without it, shares use the app's imboni:// deep link
# EXPO_PUBLIC_SHARE_BASE_URL=https://example.org

# Build time only (read by app.config.ts, not shipped to the client)
# GOOGLE_MAPS_ANDROID_API_KEY=
