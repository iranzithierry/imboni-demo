{
  "expo": {
    "name": "Imboni",
    "slug": "imboni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imboni",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.imboni.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Imboni shows where you are on the road advisories map. Your location never leaves this iPhone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.imboni.app",
      "adaptiveIcon": {
        "backgroundColor": "#FA4616",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#2A120A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#FA4616"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": false,
          "remindersPermission": false,
          "writeOnlyCalendarPermission": "Imboni adds deadlines and events you choose to your calendar. It never reads your existing events.",
          "writeOnlyAccess": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Imboni saves share cards you create to your photo library."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "Deadline",
              "displayName": "Next deadline",
              "description": "Days left on the tracked action that is due soonest.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryInline",
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/deadline.tsx"
              },
              "android": null
            },
            {
              "name": "NextEvent",
              "displayName": "Next event",
              "description": "The next calendar event from institutions you follow.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular"
                ],
                "initialLayout": "src/widgets/next-event.tsx"
              },
              "android": null
            },
            {
              "name": "Rate",
              "displayName": "Exchange rate",
              "description": "The BNR reference rate for your first watched currency.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular"
                ],
                "initialLayout": "src/widgets/rate.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.imboni.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.imboni.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1a81ed3e-bf9e-4159-b0c7-b2e3b007a090"
      }
    }
  }
}
